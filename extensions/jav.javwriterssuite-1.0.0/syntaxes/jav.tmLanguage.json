{
  "name": "jav",
  "scopeName": "source.jav",
  "fileTypes": ["jav"],
  "patterns": [
    { "include": "#header" },
    { "include": "#content" }
  ],
  "repository": {
    "header": {
      "name": "meta.header.jav",
      "begin": "^(\\s*)(.+?)\\s*(\\{[^}]*\\})?\\s*(\\[)\\s*$",
      "beginCaptures": {
        "2": { "name": "entity.name.section header1" },
        "3": { "name": "comment.block readtime" },
        "4": { "name": "punctuation.section.block.begin" }
      },
      "end": "^(\\s*)(\\])\\s*$",
      "endCaptures": {
        "2": { "name": "punctuation.section.block.end" }
      },
      "patterns": [
        { "include": "#nested-header-2" },
        { "include": "#content" }
      ]
    },
    "nested-header-2": {
      "name": "meta.header.jav",
      "begin": "^(\\s*)(.+?)\\s*(\\{[^}]*\\})?\\s*(\\[)\\s*$",
      "beginCaptures": {
        "2": { "name": "entity.name.section header2" },
        "3": { "name": "comment.block readtime" },
        "4": { "name": "punctuation.section.block.begin" }
      },
      "end": "^(\\s*)(\\])\\s*$",
      "endCaptures": {
        "2": { "name": "punctuation.section.block.end" }
      },
      "patterns": [
        { "include": "#nested-header-3" },
        { "include": "#content" }
      ]
    },
    "nested-header-3": {
      "name": "meta.header.jav",
      "begin": "^(\\s*)(.+?)\\s*(\\{[^}]*\\})?\\s*(\\[)\\s*$",
      "beginCaptures": {
        "2": { "name": "entity.name.section header3" },
        "3": { "name": "comment.block readtime" },
        "4": { "name": "punctuation.section.block.begin" }
      },
      "end": "^(\\s*)(\\])\\s*$",
      "endCaptures": {
        "2": { "name": "punctuation.section.block.end" }
      },
      "patterns": [
        { "include": "#nested-header-4" },
        { "include": "#content" }
      ]
    },
    "nested-header-4": {
      "name": "meta.header.jav",
      "begin": "^(\\s*)(.+?)\\s*(\\{[^}]*\\})?\\s*(\\[)\\s*$",
      "beginCaptures": {
        "2": { "name": "entity.name.section header4" },
        "3": { "name": "comment.block readtime" },
        "4": { "name": "punctuation.section.block.begin" }
      },
      "end": "^(\\s*)(\\])\\s*$",
      "endCaptures": {
        "2": { "name": "punctuation.section.block.end" }
      },
      "patterns": [
        { "include": "#nested-header-5" },
        { "include": "#content" }
      ]
    },
    "nested-header-5": {
      "name": "meta.header.jav",
      "begin": "^(\\s*)(.+?)\\s*(\\{[^}]*\\})?\\s*(\\[)\\s*$",
      "beginCaptures": {
        "2": { "name": "entity.name.section header5" },
        "3": { "name": "comment.block readtime" },
        "4": { "name": "punctuation.section.block.begin" }
      },
      "end": "^(\\s*)(\\])\\s*$",
      "endCaptures": {
        "2": { "name": "punctuation.section.block.end" }
      },
      "patterns": [
        { "include": "#nested-header-6" },
        { "include": "#content" }
      ]
    },
    "nested-header-6": {
      "name": "meta.header.jav",
      "begin": "^(\\s*)(.+?)\\s*(\\{[^}]*\\})?\\s*(\\[)\\s*$",
      "beginCaptures": {
        "2": { "name": "entity.name.section header6" },
        "3": { "name": "comment.block readtime" },
        "4": { "name": "punctuation.section.block.begin" }
      },
      "end": "^(\\s*)(\\])\\s*$",
      "endCaptures": {
        "2": { "name": "punctuation.section.block.end" }
      },
      "patterns": [
        { "include": "#content" }
      ]
    },
    "content": {
      "patterns": [
        { "include": "#cut-line" },
        { "include": "#definition-pair" },
        { "include": "#list-unordered" },
        { "include": "#list-ordered" },
        { "include": "#italic-dialog" },
        { "include": "#dialog" },
        { "include": "#inline-formatting" },
        { "include": "#annotations" },
        { "include": "#cut-inline" }
      ]
    },
    "definition-pair": {
      "name": "meta.definition-pair",
      "match": "^(.+?)(::)\\s*(.+)$",
      "captures": {
        "1": { "name": "keyword" },
        "2": { "name": "punctuation.separator.definition" },
        "3": {
          "name": "definition",
          "patterns": [{ "include": "#text-content" }]
        }
      }
    },
    "cut-line": {
      "name": "markup.deleted cut",
      "match": "^.+--\\s*$"
    },
    "cut-inline": {
      "name": "markup.deleted cut",
      "match": "<[^>]+>"
    },
    "annotations": {
      "patterns": [
        {
          "name": "comment.block altNotes",
          "begin": "\\\\\\\\",
          "end": "\\\\\\\\"
        },
        {
          "name": "comment.block notes",
          "begin": "\\\\",
          "end": "\\\\"
        }
      ]
    },
    "inline-formatting": {
      "patterns": [
        {
          "name": "markup.bold bold",
          "match": "\\*\\*[^*\\n]+?\\*\\*"
        },
        {
          "name": "markup.italic italics",
          "match": "\\*[^*\\n]+\\*"
        }
      ]
    },
    "dialog-content": {
      "patterns": [
        { "include": "#cut-inline" },
        {
          "name": "markup.bold bold",
          "match": "\\*\\*[^*\\n]+?\\*\\*"
        },
        {
          "name": "markup.italic italics",
          "match": "\\*[^*\\n]+\\*"
        },
        { "include": "#annotations" }
      ]
    },
    "italic-dialog-content": {
      "patterns": [
        { "include": "#cut-inline" },
        {
          "name": "markup.bold bold",
          "match": "\\*\\*[^*\\n]+?\\*\\*"
        },
        { "include": "#annotations" }
      ]
    },
    "list-unordered": {
      "name": "markup.list.unnumbered listItem",
      "match": "^\\s*([-•])\\s+(.+)$",
      "captures": {
        "1": { "name": "punctuation.definition.list" },
        "2": {
          "name": "meta.list.content",
          "patterns": [{ "include": "#text-content" }]
        }
      }
    },
    "list-ordered": {
      "name": "markup.list.numbered numberedList",
      "match": "^\\s*(\\d+\\.)\\s+(.+)$",
      "captures": {
        "1": { "name": "punctuation.definition.list" },
        "2": {
          "name": "meta.list.content",
          "patterns": [{ "include": "#text-content" }]
        }
      }
    },
    "italic-dialog": {
      "name": "string.quoted.double markup.italic italicDialog",
      "begin": "\\*[\"\u201c]",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin italicDialog" }
      },
      "end": "[\"\u201d]\\*",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end italicDialog" }
      },
      "contentName": "string.quoted.double markup.italic italicDialog",
      "patterns": [{ "include": "#italic-dialog-content" }]
    },
    "dialog": {
      "name": "string.quoted.double dialog",
      "begin": "[\"\u201c]",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin dialog" }
      },
      "end": "[\"\u201d]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end dialog" }
      },
      "contentName": "string.quoted.double dialog",
      "patterns": [{ "include": "#dialog-content" }]
    },
    "text-content": {
      "patterns": [
        { "include": "#cut-inline" },
        { "include": "#italic-dialog" },
        { "include": "#dialog" },
        { "include": "#inline-formatting" },
        { "include": "#annotations" }
      ]
    }
  }
}