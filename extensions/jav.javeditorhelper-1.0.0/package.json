{
	"name": "JavEditorHelper",
	"publisher": "Jav",
	"displayName": "Jav Editor Helper",
	"description": "Combined dialog editing, curly/straight quotes conversion, text cleanup, smart delete, smart select, and auto-capitalization.",
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.85.0"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./src/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "JavEditorHelper.toggleCase",
				"title": "Jav: Toggle Case"
			},
			{
				"command": "JavEditorHelper.editDialog",
				"title": "Jav: Edit Dialog Quotes"
			},
			{
				"command": "JavEditorHelper.convertToCurlyQuotation",
				"title": "Jav: Curly Quotation"
			},
			{
				"command": "JavEditorHelper.convertToStraightQuotation",
				"title": "Jav: Straight Quotation"
			},
			{
				"command": "JavEditorHelper.textCleanup",
				"title": "Jav: Text Cleanup"
			},
			{
				"command": "JavEditorHelper.insertSpace",
				"title": "Jav: Insert Space"
			},
			{
				"command": "JavEditorHelper.joinLineAbove",
				"title": "Jav: Join Line Above"
			},
			{
				"command": "JavEditorHelper.joinLineBelow",
				"title": "Jav: Join Line Below"
			},
			{
				"command": "JavEditorHelper.smartDelete",
				"title": "Jav: Smart Delete",
				"category": "Edit"
			},
			{
				"command": "JavEditorHelper.smartSelect",
				"title": "Jav: Smart Select Expand"
			},
			{
				"command": "JavEditorHelper.selectSurround",
				"title": "Jav: Select Inside Surrounding Pairs"
			},
			{
				"command": "JavEditorHelper.removeSurround",
				"title": "Jav: Remove Surrounding Pairs"
			}
		],
		"configuration": {
			"title": "JavEditorHelper",
			"properties": {
				"JavEditorHelper.capitalizationFilePaths": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Array of absolute paths to .txt files containing words/phrases to force-capitalize, one per line."
				},
				"smartDelete.suffixes": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"s",
						"es",
						"ed",
						"ing",
						"er",
						"est",
						"ly",
						"ion",
						"tion",
						"ation",
						"ment",
						"ness",
						"ity",
						"al",
						"able",
						"ible",
						"ship",
						"ous",
						"ful",
						"less",
						"ish",
						"ive",
						"ize",
						"ise",
						"ance",
						"ence",
						"y"
					],
					"description": "Word suffixes stripped one at a time when cursor is at end-of-word. Longest match wins."
				},
				"JavEditorHelper.surroundingPairs": {
					"type": "array",
					"default": [
						[
							"[",
							"]"
						],
						[
							"{",
							"}"
						],
						[
							"(",
							")"
						],
						[
							"'",
							"'"
						],
						[
							"\"",
							"\""
						],
						[
							"*",
							"*"
						],
						[
							"<",
							">"
						]
					],
					"description": "Character pairs to recognize as surrounding delimiters."
				}
			}
		}
	},
	"__metadata": {
		"installedTimestamp": 1773255429007,
		"targetPlatform": "undefined",
		"size": 54891
	}
}